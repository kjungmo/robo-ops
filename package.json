{
  "name": "robo-ops",
  "private": true,
  "version": "0.1.0",
  "description": "Operator console for AMR/AGV fleets and PACT, a lifelong fleet-management module (task allocation, multi-agent path finding, charging) with its benchmark and paper",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjungmo/robo-ops.git"
  },
  "author": "Jungmo Kang <kangjmo91@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "bench:fms": "tsx scripts/bench-fms.ts",
    "paper:data": "tsx scripts/paper-data.ts",
    "check:paper": "tsx scripts/check-paper.ts",
    "check:results": "tsx scripts/check-results.ts",
    "regenerate": "bash scripts/regenerate.sh",
    "measure:timing": "bash scripts/measure-timing.sh",
    "extract:console-site": "tsx scripts/extract-console-site.ts"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.7"
  }
}
